# Коротко про АА — базове налаштування для хостингу

# Кодування за замовчуванням
AddDefaultCharset utf-8

# Головна сторінка
DirectoryIndex index.html

# Плавне прокручування до якорів працює без додаткових правил.

# Стиснення текстових файлів
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/xml application/xml
</IfModule>

# Кешування статичних файлів
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 1 hour"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType application/xml "access plus 1 hour"
</IfModule>

# Sitemap (замініть example.com на ваш домен)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^sitemap\.xml$ /sitemap.xml [L]
</IfModule>
